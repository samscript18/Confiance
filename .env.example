# No private keys. Owner signing uses Mera or an encrypted Foundry keystore.
# Public canonical website origin for SEO; independent of the owner console origin.
SITE_URL=https://confiance-eta.vercel.app
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
CONFIANCE_ADDRESS=
CONFIANCE_DEPLOYMENT_BLOCK=
# Owner account address for the Foundry deployment script; not a secret.
CONFIANCE_OWNER=
DEPLOY_TEST_TOKEN=false
PAYMENT_ASSET=
PAYMENT_RECIPIENT=
# Display denomination is token units; no dollar value is assumed.
PAYMENT_AMOUNT=30

PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AGENT_WALLET_ID=
AGENT_ADDRESS=
# Commit a real registry identity when available. A local test label is not ERC-8004.
AGENT_IDENTITY_COMMITMENT=
SESSION_LIMIT_WHOLE_UNITS=50
# Explicitly disables the GitHub condition ONLY for the core testnet security proof.
# Keep false for the payroll milestone demo.
CORE_SMOKE_TEST=false
# Optional authorization private key supplied by Privy, server only.
PRIVY_AUTHORIZATION_KEY=

# Existing provider with OpenAI-compatible chat-completions and tool calling.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_PROVIDER=vertex
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
# Optional service-account path or JSON; otherwise Google ADC is used. Server only.
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_CREDENTIALS_JSON=

GITHUB_REPO=
GITHUB_PR_NUMBER=42
GITHUB_TOKEN=

# Confirm from the authenticated CRE tenant directory; never guess addresses.
CHAINLINK_CRE_FORWARDER=
CHAINLINK_CRE_WORKFLOW_ID=
CHAINLINK_CRE_WORKFLOW_OWNER=

# Unconfirmed until official Cleanverse materials support the intended path.
CLEANVERSE_A_TOKEN=
CLEANVERSE_APASS_CONTRACT=
CLEANVERSE_CCP=
CLEANVERSE_ADAPTER=
CLEANVERSE_VALIDATOR=
# Sandbox api-id header. Encryption key remains server-only; never send it as a header.
CLEANVERSE_API_ID=
# App ID supplied with the API key; used as the documented api-id header.
CLEANVERSE_APP_ID=
CLEANVERSE_API_KEY=

ERC8004_IDENTITY_REGISTRY=
ERC8004_AGENT_URI=
ERC8004_AGENT_ID=
ENVIO_GRAPHQL_URL=
ENVIO_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CRE_MONAD_TESTNET_WRITE_CONFIRMED=false
WEB_ORIGIN=http://localhost:3000
OWNER_CONSOLE_URL=
# Optional public browser RPC. Never use a private provider URL/API key here.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
AGENT_POLL_SECONDS=120
DIAGNOSTIC_RECIPIENT=
MONGODB_URI=
MONGODB_DB=confiance-db
CONFIANCE_STORAGE_NAMESPACE=confiance-local
# Vercel only; Render/local backend leaves this blank.
CONFIANCE_BACKEND_URL=
# Shared server-only proxy secret, at least 32 characters.
CONFIANCE_PROXY_SECRET=
# Public HTTPS task discovery endpoint for CRE.
CRE_TASKS_URL=
CONFIANCE_ALLOW_FILE_STORAGE=false
