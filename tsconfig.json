{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "agent/**/*.ts",
    "scripts/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ]
}
